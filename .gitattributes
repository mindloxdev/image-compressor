# Normalise to LF in the repository regardless of the platform committing.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.wasm binary
*.woff binary
*.woff2 binary
*.zip binary

# Generated, and noisy in review.
package-lock.json -diff linguist-generated
